# ONOBILL environment — salin menjadi .env lalu sesuaikan
APP_PORT=8080
BASE_URL=http://localhost:8080
DB_DRIVER=sqlite
DB_PATH=./onobill.db
APP_ENV=production
# Ganti dengan nilai acak kuat di production!
JWT_SECRET=change-me-to-a-long-random-string

# MySQL (bila DB_DRIVER=mysql)
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=onobill
# DB_PASSWORD=secret
# DB_NAME=onobill

# Payment gateway (opsional — bisa juga diatur dari menu Superadmin > Payment)
# DUITKU_MERCHANT=
# DUITKU_API_KEY=
# DUITKU_BASE_URL=
# KLIKQRIS_MERCHANT=
# KLIKQRIS_API_KEY=
# KLIKQRIS_BASE_URL=
